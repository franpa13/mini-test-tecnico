# Copiar este archivo a .env.local y completar los valores para desarrollo local.
# .env.local NO se commitea (ver .gitignore); .env.example sí, como plantilla del equipo.

# Puerto en el que corre el frontend. Documentado acá como referencia; Next.js solo lee el
# puerto de una variable de entorno real del SO (no de este archivo), así que el valor real
# se fija con "-p 4001" en el script "dev" de package.json. Si lo cambiás, actualizá ambos.
PORT=4001

# URL base del backend (NestJS) que expone GET /user/:username.
# NEXT_PUBLIC_ es obligatorio para que la variable esté disponible en el cliente (browser).
# En desarrollo: server local. En producción: la URL de deploy del backend.
NEXT_PUBLIC_API_URL=http://localhost:4000
