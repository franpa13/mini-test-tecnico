# Copiar este archivo a .env y completar los valores para desarrollo local.
# .env NO se commitea (ver .gitignore); .env.example sí, como plantilla del equipo.

# Puerto en el que escucha el backend (NestJS).
PORT=4000

# Origen permitido por CORS: la URL del frontend (Next.js).
# En desarrollo: el puerto donde corre client/. En producción: la URL de deploy del frontend.
CORS_ORIGIN=http://localhost:4001

# Base URL de la API pública de GitHub que consulta GET /user/:username.
# No debería necesitar cambiarse salvo para testear contra un mock.
GITHUB_API_URL=https://api.github.com

# Opcional. Personal Access Token de GitHub (classic, sin ningún scope marcado alcanza).
# La API pública de GitHub limita a 60 requests/hora por IP sin autenticar, 5000/hora con token.
# Para este mini-reto no es obligatorio, pero evita un 403 "rate limit exceeded" si se prueba mucho.
# Generar en: https://github.com/settings/tokens -> Tokens (classic) -> Generate new token.
GITHUB_TOKEN=
